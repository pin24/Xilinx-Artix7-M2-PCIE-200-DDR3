[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
; FIX-5 (Task 32): version bumped 1.0.0.0 -> 1.1.0.0. REQUIRED for re-install:
; pnputil /add-driver refuses to update an already-staged package when the
; new package's DriverVer is not strictly newer. Every driver fix must bump
; the version part (date part is re-stamped by stampinf -d * at build time).
DriverVer=09/11/2026,1.1.4.0
CatalogFile=XDMA.cat

[Manufacturer]
%Provider%=Standard,NTamd64

[Standard.NTamd64]
%DeviceDesc%=XDMA_Inst, PCI\VEN_10ee&DEV_7024

[XDMA_Inst.NT]
CopyFiles=CopyFiles

[XDMA_Inst.NT.Services]
AddService=XDMA,0x00000002,ServiceInstall

[ServiceInstall]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\XDMA.sys

; FIX F1 (DRV-5 INF-1): KMDF WDF section — required for WdfDriverCreate to
; initialize correctly during PnP install. Without this, pnputil /add-driver
; fails with STATUS_WDF_VERIFICATION_FAILURE. Section name must match the
; DDInstall section ([XDMA_Inst.NT] -> [XDMA_Inst.NT.Wdf]).
[XDMA_Inst.NT.Wdf]
KmdfService=XDMA, XDMA_wdfsect

[XDMA_wdfsect]
KmdfLibraryVersion=1.15

[CopyFiles]
XDMA.sys

[DestinationDirs]
CopyFiles=12

[SourceDisksNames]
1 = %DiskId1%

[SourceDisksFiles]
XDMA.sys = 1

[Strings]
Provider="MultiTool"
DeviceDesc="XDMA DDR3 Ternary Accelerator v1.1"
DiskId1="XDMA Driver Installation Disk"