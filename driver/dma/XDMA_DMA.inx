[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
; РђРІС‚РѕРЅРѕРјРЅС‹Р№ DMA-РґСЂР°Р№РІРµСЂ XDMA (upstream-СЃС‚РµРє: file_io.c + libxdma).
; Р’РµСЂСЃРёСЋ РїРµСЂРµР·Р°РїРёСЃС‹РІР°РµС‚ stampinf -v РїСЂРё СЃР±РѕСЂРєРµ (build.cmd). Р”РѕР»Р¶РЅР° Р±С‹С‚СЊ СЃС‚СЂРѕРіРѕ
; РЅРѕРІРµРµ СѓР¶Рµ СѓСЃС‚Р°РЅРѕРІР»РµРЅРЅРѕР№, РёРЅР°С‡Рµ pnputil РЅРµ РѕР±РЅРѕРІРёС‚ РїР°РєРµС‚.
DriverVer=10/20/2026,1.2.6.0
CatalogFile=XDMA_DMA.cat

[Manufacturer]
%Provider%=Standard,NTamd64

[Standard.NTamd64]
%DeviceDesc%=XDMA_DMA_Inst, PCI\VEN_10ee&DEV_7024

[XDMA_DMA_Inst.NT]
CopyFiles=CopyFiles
AddReg=XDMA_DMA_AddReg

; Р РµРіРёСЃС‚СЂР°С†РёСЏ РёСЃС‚РѕС‡РЅРёРєР° СЃРѕР±С‹С‚РёР№ РґР»СЏ IoWriteErrorLogEntry (Event Log, System log).
; Р‘РµР· EventMessageFile Р¶СѓСЂРЅР°Р» РЅРµ РѕС‚РѕР±СЂР°Р¶Р°РµС‚ Р·Р°РїРёСЃРё РѕС‚ РґСЂР°Р№РІРµСЂР° вЂ” РїРѕСЌС‚РѕРјСѓ РґРѕР±Р°РІР»СЏРµРј
; РєР»СЋС‡ РІ Services\EventLog\System\XDMA_DMA, СѓРєР°Р·С‹РІР°СЏ РЅР° .sys РєР°Рє message file.
[XDMA_DMA_AddReg]
HKLM, "SYSTEM\CurrentControlSet\Services\EventLog\System\XDMA_DMA", "EventMessageFile", %REG_EXPAND_SZ%, "%12%\XDMA_DMA.sys"
HKLM, "SYSTEM\CurrentControlSet\Services\EventLog\System\XDMA_DMA", "TypesSupported", %REG_DWORD%, 0x7

[XDMA_DMA_Inst.NT.Services]
AddService=XDMA_DMA,0x00000002,ServiceInstall

[ServiceInstall]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\XDMA_DMA.sys

; KMDF WDF-СЃРµРєС†РёСЏ вЂ” РѕР±СЏР·Р°С‚РµР»СЊРЅР° РґР»СЏ WdfDriverCreate РІРѕ РІСЂРµРјСЏ PnP-СѓСЃС‚Р°РЅРѕРІРєРё.
[XDMA_DMA_Inst.NT.Wdf]
KmdfService=XDMA_DMA, XDMA_DMA_wdfsect

[XDMA_DMA_wdfsect]
KmdfLibraryVersion=1.15

[CopyFiles]
XDMA_DMA.sys

[DestinationDirs]
CopyFiles=12

[SourceDisksNames]
1 = %DiskId1%

[SourceDisksFiles]
XDMA_DMA.sys = 1

[Strings]
Provider="MultiTool"
DeviceDesc="XDMA DMA Subsystem (upstream stack, h2c/c2h channels)"
DiskId1="XDMA DMA Driver Installation Disk"
REG_EXPAND_SZ=0x00020000
REG_DWORD=0x00010001
