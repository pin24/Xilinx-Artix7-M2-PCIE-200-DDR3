[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
; Автономный DMA-драйвер XDMA (upstream-стек: file_io.c + libxdma).
; Версию перезаписывает stampinf -v при сборке (build.cmd). Должна быть строго
; новее уже установленной, иначе pnputil не обновит пакет.
DriverVer=09/27/2026,1.1.15.0
CatalogFile=XDMA_DMA.cat

[Manufacturer]
%Provider%=Standard,NTamd64

[Standard.NTamd64]
%DeviceDesc%=XDMA_DMA_Inst, PCI\VEN_10ee&DEV_7024

[XDMA_DMA_Inst.NT]
CopyFiles=CopyFiles

[XDMA_DMA_Inst.NT.Services]
AddService=XDMA_DMA,0x00000002,ServiceInstall

[ServiceInstall]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\XDMA_DMA.sys

; KMDF WDF-секция — обязательна для WdfDriverCreate во время PnP-установки.
[XDMA_DMA_Inst.NT.Wdf]
KmdfService=XDMA_DMA, XDMA_DMA_wdfsect

[XDMA_DMA_wdfsect]
KmdfLibraryVersion=1.15

[CopyFiles]
XDMA_DMA.sys

[DestinationDirs]
CopyFiles=12

[SourceDisksNames]
1 = %DiskId1%

[SourceDisksFiles]
XDMA_DMA.sys = 1

[Strings]
Provider="MultiTool"
DeviceDesc="XDMA DMA Subsystem (upstream stack, h2c/c2h channels)"
DiskId1="XDMA DMA Driver Installation Disk"