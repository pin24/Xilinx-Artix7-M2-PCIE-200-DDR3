"""Формат TFloat48 - троичная плавающая запятая (balanced ternary), блочный.

Спецификация (согласовано с аппаратной блочной частью):
    Всего 24 трита = 48 бит = 6 байт (по 4 трита в байте).
    Поля (старшие триты первыми):
        M  : 20 тритов мантиссы (5 байт), нормализована [3^19, 3^20)
        E  :  4 трита экспоненты (1 байт), balanced [-40, +40], bias 40
    Значение:
        v = M * 3^(e - 19),  e = E_decoded - 40
        (E хранит e+40; при 4 тритах физически decode(E) даёт e)
    Кодирование тритов: +1->01, 0->00, -1->10, 11->ошибка.

Кодирование всего числа: 48-битный int:
    [M:40 бит][E:8 бит]  (старшие биты - первые триты мантиссы)
    byte[5]=старшие триты мантиссы, ..., byte[1]=младшие триты мантиссы,
    byte[0]=экспонента.
"""
from __future__ import annotations
from typing import Tuple, Optional
import struct

from . import trits as T

# --- параметры формата ---
M_TRITS = 20
E_TRITS = 4
TOTAL_TRITS = M_TRITS + E_TRITS   # 24
TOTAL_BITS = TOTAL_TRITS * 2      # 48
E_BIAS = 40

# границы нормализованной мантиссы [3^19, 3^20)
M_SCALE = 3 ** 19
M_NORM_MIN = M_SCALE           # 3^19
M_NORM_MAX = 3 * M_SCALE       # 3^20
E_MAX = (3 ** E_TRITS - 1) // 2   # 40

# --- поля как битовые маски (48-битный int) ---
_E_SHIFT = 0
_M_SHIFT = E_TRITS * 2  # 8

MASK_E = (1 << (_M_SHIFT)) - 1
MASK_M = ((1 << (M_TRITS * 2)) - 1) << _M_SHIFT


class TFloatError(Exception):
    """Ошибка троичной арифметики (деление на ноль, NaN и т.п.)."""


class TFloat:
    """Неизменяемое значение TFloat48.

    Хранит: m_int (20 тритов мантиссы, упакованы в int), e_int (4 трита
    экспоненты, упакованы), err (bool - флаг ошибки/NaN).
    """

    __slots__ = ("m_int", "e_int", "err")

    def __init__(self, m_int: int, e_int: int, err: bool = False):
        self.m_int = m_int
        self.e_int = e_int
        self.err = err

    # ---- фабрики ----
    @classmethod
    def from_float(cls, value: float) -> "TFloat":
        """Преобразовать Python float (в идеале float32-значение) в TFloat48.

        Конвенция: value = M * 3^(e-19), где M - целая мантисса в [3^19, 3^20)
        (нормализована), e - троичная экспонента. M хранится как 20 тритов.
        """
        if value != value or value in (float("inf"), float("-inf")):
            return cls(0, 0, err=True)
        if value == 0.0:
            return cls(0, 0, err=False)  # ноль: мантисса 0, экспонента 0

        neg = value < 0
        av = abs(value)

        # троичная экспонента: e = floor(log3(av))
        e = _ilog3(av)
        # целевая целая мантисса: M = av * 3^19 / 3^e  in [3^19, 3^20)
        M_target = int(av * (3.0 ** (M_TRITS - 1)) / (3.0 ** e) + 0.5)
        while M_target >= M_NORM_MAX:
            M_target //= 3
            e += 1
        while M_target < M_NORM_MIN and e > -E_BIAS:
            M_target *= 3
            e -= 1

        m_trits = _int_to_trits(M_target, M_TRITS)
        if neg:
            m_trits = tuple(-t for t in m_trits)

        # ограничение экспоненты
        if e < -E_BIAS:
            return cls(0, 0)  # underflow
        if e > E_MAX:
            raise TFloatError("overflow: экспонента вне диапазона")

        return cls(
            T.pack(m_trits),
            T.pack(_encode_exp(e)),
        )

    @classmethod
    def from_bits(cls, bits: int) -> "TFloat":
        """Декодировать 48-битное целое в TFloat."""
        if bits < 0 or bits >= (1 << TOTAL_BITS):
            raise ValueError(f"bits вне 48-битного диапазона: {bits}")
        m_int = (bits & MASK_M) >> _M_SHIFT
        e_int = bits & MASK_E
        err = _has_err(m_int, M_TRITS) or _has_err(e_int, E_TRITS)
        return cls(m_int, e_int, err)

    # ---- представления ----
    def to_bits(self) -> int:
        """Кодировать в 48-битное целое."""
        if self.err:
            # гарантировать код ошибки: мантисса = все 11
            m_bits = (T.CODE_ERR << (2 * (M_TRITS - 1)))
            m_bits = (m_bits | ((1 << (M_TRITS * 2)) - 1))  # все биты 1 -> все 11
            return (m_bits << _M_SHIFT) | self.e_int
        return ((self.m_int & ((1 << (M_TRITS * 2)) - 1)) << _M_SHIFT) | (self.e_int & MASK_E)

    def to_float(self) -> float:
        """Приближённое значение как Python float.

        value = M * 3^(e-19), M - целая мантисса (20 тритов).
        """
        if self.err:
            return float("nan")
        if self.m_int == 0:
            return 0.0
        m = _trits_value(T.unpack(self.m_int, M_TRITS))  # целое M
        e = _decode_exp(T.unpack(self.e_int, E_TRITS))
        v = m * (3.0 ** (e - (M_TRITS - 1)))
        return struct.unpack("f", struct.pack("f", v))[0]

    def is_zero(self) -> bool:
        return not self.err and self.m_int == 0

    def is_error(self) -> bool:
        return self.err

    def __repr__(self) -> str:
        if self.err:
            return "TFloat(ERR)"
        return f"TFloat({self.to_float():.9g})"


# --- внутренние помощники ---

def _encode_exp(e: int) -> Tuple[int, ...]:
    """Экспонента (без bias) в 4 трита balanced ternary (старший первым).

    e in [-40, 40].
    """
    if e < -E_BIAS or e > E_MAX:
        raise TFloatError(f"экспонента вне диапазона: {e}")
    out = []
    v = e
    for _ in range(E_TRITS):
        r = v % 3
        v //= 3
        if r == 2:
            r = -1
            v += 1
        out.append(r)
    if v != 0:
        raise TFloatError("экспонента не помещается в 4 трита")
    return tuple(reversed(out))


def _decode_exp(e_trits: Tuple[int, ...]) -> int:
    """Декодировать balanced ternary экспоненту (старший трит - знаковый)."""
    v = 0
    for t in e_trits:
        v = v * 3 + t
    return v


def _has_err(packed: int, n: int) -> bool:
    for i in range(n):
        if ((packed >> (2 * i)) & 0b11) == T.CODE_ERR:
            return True
    return False


def _trits_value(trits: Tuple[int, ...]) -> float:
    """Значение кортежа тритов как целое (мантисса)."""
    v = 0
    for t in trits:
        v = v * 3 + t
    return float(v)


def _int_to_trits(m: int, n: int) -> Tuple[int, ...]:
    """Разложить целое m в n тритов (balanced, старший первым)."""
    out = [0] * n
    v = m
    for i in range(n - 1, -1, -1):
        r = v % 3
        v //= 3
        if r == 2:
            r = -1
            v += 1
        out[i] = r
    return tuple(out)


def _ilog3(x: float) -> int:
    """floor(log3(|x|)) для x>0."""
    import math
    e = int(math.floor(math.log2(abs(x)) / math.log2(3.0)))
    if 3.0 ** (e + 1) <= abs(x):
        e += 1
    elif 3.0 ** e > abs(x):
        e -= 1
    return e
